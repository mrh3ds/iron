{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iron",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5cab58aa-16cb-42bd-8dd9-1397907715a3","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e60adacb9a5a4ad587eb4a5a2ca97d74" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
